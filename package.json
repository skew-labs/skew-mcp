{
  "name": "@skew-labs/mcp",
  "version": "0.7.17",
  "description": "MCP server for Skew — AI agents create, buy, and settle Solana options through Claude, Cursor, or Copilot.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/skew-labs/skew/tree/main/skew/skew-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skew-labs/skew.git",
    "directory": "skew/skew-mcp"
  },
  "bugs": {
    "url": "https://github.com/skew-labs/skew/issues"
  },
  "keywords": [
    "solana",
    "options",
    "mcp",
    "mcp-server",
    "claude",
    "cursor",
    "ai-agents",
    "skew"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mcp": "dist/server.js",
    "skew-mcp": "dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/make_executable.mjs",
    "dev": "node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "verify:no-leak": "node scripts/verify_no_leak.mjs",
    "verify:tool-schemas": "node scripts/verify_tool_schemas.mjs",
    "prepublishOnly": "npm run build && npm run verify:no-leak && npm run verify:tool-schemas"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@skew-labs/sdk": "^0.7.7",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  }
}

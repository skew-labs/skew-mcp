{
  "name": "@skew-labs/mcp",
  "version": "0.2.2",
  "description": "MCP server for Skew — AI agents create, buy, and settle Solana options through Claude, Cursor, or Copilot.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/skew-labs/skew-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/skew-labs/skew-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/skew-labs/skew/issues"
  },
  "keywords": [
    "solana",
    "options",
    "mcp",
    "mcp-server",
    "claude",
    "cursor",
    "ai-agents",
    "skew"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skew-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "verify:no-leak": "node scripts/verify_no_leak.mjs",
    "prepublishOnly": "npm run build && npm run verify:no-leak"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@skew-labs/sdk": "^0.2.0",
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.3",
    "@solana/spl-token": "^0.4.14",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0"
  }
}
